{
	"name": "@stump/expo",
	"main": "index.js",
	"version": "0.1.5",
	"license": "GPL-3.0-only",
	"scripts": {
		"dev": "expo start -c --ios",
		"dev:web": "expo start -c --web",
		"dev:android": "expo start -c --android",
		"android": "expo run:android -d",
		"ios": "expo run:ios -d",
		"web": "expo start -c --web",
		"test": "vitest run",
		"test:watch": "vitest",
		"open:ios": "xed ios",
		"open:android": "open -a \"Android Studio\" android",
		"postinstall": "npx tailwindcss -i ./global.css -o ./node_modules/.cache/nativewind/global.css",
		"android:format": "ktlint --format \"./modules/**/*.kt\"",
		"ios:format": "swiftformat ./modules",
		"ts:format": "prettier --config ../../prettier.config.js --ignore-path ../../.prettierignore --write .",
		"format": "yarn ts:format && yarn ios:format && yarn android:format",
		"clean": "rimraf .expo node_modules ios android",
		"check-types": "tsc -b tsconfig.json"
	},
