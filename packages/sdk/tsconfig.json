{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"module": "ES2022",
		"moduleResolution": "Node",
		"composite": true,
		"skipLibCheck": true,
		"emitDeclarationOnly": true,
		"outDir": "dist",
		"types": ["node", "vitest/globals"],
		"paths": {
			"@stump/graphql": ["../graphql/src/index.ts"],
		},
	},
	"include": ["src"],
	"exclude": ["node_modules"],
	"references": [
		{
			"path": "../graphql",
		},
	],
}
