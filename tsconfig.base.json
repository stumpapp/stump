{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true,
		"plugins": [
			{
				"name": "@0no-co/graphqlsp",
				"schema": "../../crates/graphql/schema.graphql"
			}
		],
		"allowImportingTsExtensions": true,
		"paths": {
			"@stump/browser/*": ["./packages/browser/src/*"],
			"@stump/client/*": ["./packages/client/src/*"],
			"@stump/components/*": ["./packages/components/src/*"],
			"@stump/graphql/*": ["./packages/graphql/src/*"],
			"@stump/i18n/*": ["./packages/i18n/src/*"],
			"@stump/sdk/*": ["./packages/sdk/src/*"],
			"@/*": ["./packages/browser/src/*"]
		}
	}
}
